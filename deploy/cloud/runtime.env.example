# Names only. Copy to /etc/utilivault/runtime.env and add values locally.
ANTHROPIC_API_KEY=
GOOGLE_OAUTH_CLIENT_JSON=/run/secrets/utilivault/oauth_client.json
GOOGLE_OAUTH_TOKEN_JSON=/run/secrets/utilivault/oauth_token.json
DEMO_PROJECTS_FOLDER_ID=
PROJECT_PICTURE_INTAKE_FOLDER_ID=
UTILIVAULT_ENVIRONMENT=test
UTILIVAULT_PRODUCTION_WATCHER_ENABLED=
UTILIVAULT_ALERT_WEBHOOK_URL=

# Set every explicit folder ID to dedicated test folders during shadow testing.
UTILIVAULT_ROOT_FOLDER_ID=
FIELD_INTAKE_FOLDER_ID=
FIELD_OUTPUT_FOLDER_ID=
FIELD_ORIGINALS_FOLDER_ID=
FIELD_DIGITAL_FOLDER_ID=
CLEAN_PHOTO_INPUT_FOLDER_ID=

