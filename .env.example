# Copy this file to .env and fill in local values. Never commit .env.
# All identifiers and contact details below are placeholders.
ANTHROPIC_API_KEY=
UTILIVAULT_HOME=./local
UTILIVAULT_SECRETS_DIR=./local/secrets
UTILIVAULT_STATE_DIR=./local/state
GOOGLE_OAUTH_CLIENT_JSON=./local/secrets/oauth_client.json
GOOGLE_OAUTH_TOKEN_JSON=./local/secrets/oauth_token.json
GOOGLE_OAUTH_STATE_JSON=./local/state/oauth_state.json
GOOGLE_OWNER_EMAIL=YOUR_EMAIL@example.com
GOOGLE_SERVICE_ACCOUNT_JSON=./local/secrets/service_account.json
GOOGLE_APPLICATION_CREDENTIALS=./local/secrets/vision_service_account.json
SPREADSHEET_ID=YOUR_SPREADSHEET_ID
WATER_REGISTRY_SHEET_ID=YOUR_WATER_REGISTRY_SHEET_ID
DRIVE_SCAN_FOLDER=YOUR_DRIVE_SCAN_FOLDER_ID
PROJECT_PICTURE_INTAKE_FOLDER_ID=YOUR_PROJECT_PICTURE_INTAKE_FOLDER_ID
DEMO_PROJECTS_FOLDER_ID=YOUR_PROJECTS_FOLDER_ID
UTILIVAULT_ROOT_FOLDER_ID=YOUR_UTILIVAULT_ROOT_FOLDER_ID
FIELD_INTAKE_FOLDER_ID=YOUR_FIELD_INTAKE_FOLDER_ID
FIELD_OUTPUT_FOLDER_ID=YOUR_FIELD_OUTPUT_FOLDER_ID
FIELD_ORIGINALS_FOLDER_ID=YOUR_FIELD_ORIGINALS_FOLDER_ID
FIELD_DIGITAL_FOLDER_ID=YOUR_FIELD_DIGITAL_FOLDER_ID
CLEAN_PHOTO_INPUT_FOLDER_ID=YOUR_CLEAN_PHOTO_INPUT_FOLDER_ID
UTILIVAULT_CLOUD_RUNTIME=
UTILIVAULT_ENVIRONMENT=development
UTILIVAULT_PRODUCTION_WATCHER_ENABLED=
UTILIVAULT_ALERT_WEBHOOK_URL=
UTILIVAULT_FONT_REGULAR=
UTILIVAULT_FONT_BOLD=
UTILIVAULT_API_KEY=replace-with-a-local-random-value
EXPO_TOKEN=
UTILIVAULT_CONTACT_EMAIL=YOUR_EMAIL@example.com
